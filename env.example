# Copiar a .env para correr local. NUNCA subir el .env real a GitHub.

# --- WhatsApp / Meta ---
VERIFY_TOKEN=fachavi-verify-2026
WHATSAPP_TOKEN=pega-tu-token-de-whatsapp
PHONE_NUMBER_ID=pega-el-id-del-numero
GRAPH_API_VERSION=v21.0

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Google Sheets ---
# Pegar TODO el JSON del service account en una sola linea (o entre comillas).
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# ID del libro: lo que va entre /d/ y /edit en la URL de tu Google Sheet.
SPREADSHEET_ID=pega-el-id-del-libro

# --- Ajustes opcionales ---
CACHE_TTL_SECONDS=60
MAX_RESULT_ROWS=100
