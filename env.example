# Copiar a .env para correr local. NUNCA subir el .env real a GitHub.
#
# Este repo tiene DOS mitades y este archivo cubre las dos (B-39):
#   - la INGESTA (sync.py): cron que extrae de los sistemas fuente y escribe
#     en el warehouse;
#   - el BOT de WhatsApp (bot/): servicio web que responde preguntas leyendo
#     del warehouse, con Gemini y text-to-SQL.
# La ingesta funciona sin ninguna variable del bot, y viceversa.

# --- Google (un solo service account lee el maestro Y los Sheets de datos) ---
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# ID del SHEET MAESTRO (registro de clientes/fuentes), NO el de datos.
MASTER_SPREADSHEET_ID=pega-el-id-del-sheet-maestro

# --- Warehouse ---
# Opcion A: Neon / Postgres administrado (produccion)
WAREHOUSE_TIPO=postgres
WAREHOUSE_DSN=postgresql://usuario:clave@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Opcion B: DuckDB local (desarrollo, sin credenciales)
# WAREHOUSE_TIPO=duckdb
# WAREHOUSE_DSN=fachavi.duckdb

# --- Opcional: un proyecto de Neon POR CLIENTE ---
# El nombre es WAREHOUSE_DSN_ + cliente_id en mayusculas.
# WAREHOUSE_DSN_CLIENTE_A=postgresql://...
# WAREHOUSE_DSN_CLIENTE_B=postgresql://...

# --- Secretos de los CONECTORES (C-04) ---
# Regla del proyecto: el Sheet nunca lleva credenciales, lleva el NOMBRE de la
# variable que las guarda. Esto ya se cumplia para el warehouse propio; ahora
# tambien para las bases y APIs de los clientes.
#
#   En la columna 'config' de la pestania 'fuentes':
#     {"dsn_env": "PG_FERRETERIA_A", "tablas": ["ventas"]}
#     {"url": "https://...", "headers_env": "API_TOKEN_FERRETERIA_A"}
#
#   Y el secreto vive aca (o en el panel de Render):
# PG_FERRETERIA_A=postgresql://usuario:clave@host:5432/db
# API_TOKEN_FERRETERIA_A={"Authorization":"Bearer XXXX"}

# --- Ajustes de la ingesta ---
REGISTRY_CACHE_TTL=300
# Modo de corrida del job (se cambia desde el dashboard de Render):
#   --probar | (vacio) | --forzar | --estado
# En produccion va VACIO: con --forzar se anula todo el sistema de frescura
# y cada fuente se recarga 96 veces al dia (C-02).
SYNC_ARGS=--probar
# Retencion de la bitacora _meta.sync_corridas en dias. 0 = no purgar (A-04).
SYNC_RETENCION_DIAS=180
# Convencion de fecha: dia_primero (tica) | mes_primero (anglosajona). Cada
# fuente lo puede pisar con {"formato_fecha":"mes_primero"} en su config (A-07).
FORMATO_FECHA=dia_primero
# Si los datos prueban otra convencion (un dia > 12), hacerles caso y avisar.
FECHA_AUTOCORREGIR=si

# --- BOT de WhatsApp (capa de lectura) ---
# Produccion: Vertex AI reutiliza GOOGLE_CREDENTIALS_JSON. El service account
# necesita el rol roles/aiplatform.user y Vertex AI API habilitada.
GEMINI_BACKEND=vertex
GEMINI_LOCATION=global
BOT_TIMEZONE=America/Costa_Rica
GEMINI_MODELO=gemini-3.6-flash
GEMINI_TIMEOUT_SEGUNDOS=90
# Opcional si Vertex vive en otro proyecto; vacio usa project_id del JSON.
# GEMINI_PROJECT_ID=mi-proyecto-gcp
# Alternativa local: GEMINI_BACKEND=api_key y GEMINI_API_KEY=...
BOT_MODELO_SQL=gemini-3.6-flash
BOT_MODELO_RESPUESTA=gemini-3.6-flash
BOT_MAX_FILAS=200
BOT_TIMEOUT_MS=8000
BOT_MAX_TOKENS_SQL=1200         # 600 truncaba consultas con JOINs (B-24)
# ¿Tabla sin 'instruccion' en el catalogo se puede usar? no = fail-closed.
# En "si" quedan abiertas TODAS las tablas sin documentar de TODOS los
# clientes. Solo para depurar, y acordate de bajarlo (C-05).
BOT_PERMITIR_SIN_INSTRUCCION=no

# --- Topes de consumo (A-13, A-14) ---
# Cada mensaje gasta entre 3 y 5 llamadas al modelo. 0 = sin limite.
BOT_MAX_MSJ_POR_MINUTO=12
BOT_MAX_MSJ_POR_DIA=300

# --- Memoria conversacional (recuerda el hilo, incluso dias atras) ---
BOT_MEMORIA=si                 # si/no; apagala para volver al bot sin memoria
BOT_MEMORIA_MAX_TURNOS=20      # cuantos turnos se cargan como contexto
BOT_MEMORIA_VENTANA_HORAS=72   # recencia: 72 = 3 dias
BOT_MEMORIA_TTL_DIAS=30        # retencion: se purga lo mas viejo que esto

# Confirmacion de entrega de PDF/Excel/graficos. Un status=failed de Meta
# reutiliza el media_id y reintenta una vez; 0 desactiva ese reintento.
BOT_ADJUNTO_REINTENTOS_ENTREGA=1
BOT_ADJUNTO_ENTREGAS_TTL_DIAS=30

# --- Clasificador de intencion + capa semantica de KPIs ---
BOT_INTENCION=si               # rutea datos/meta/saludo antes del SQL
BOT_KPIS=si                    # usa métricas del tab _kpis (match/pedir/retar)

# --- Notas de voz entrantes ---
# Gemini convierte voz->texto y luego procesa la consulta como cualquier
# mensaje escrito. El audio no se conserva en el warehouse.
BOT_AUDIO_ENTRANTE=si
BOT_AUDIO_MODELO=gemini-3.6-flash
BOT_AUDIO_MAX_MB=5
BOT_AUDIO_TIMEOUT_SEGUNDOS=90

# --- WhatsApp Cloud API (Meta / Graph API) ---
# Token de acceso de la app (Bearer). El del panel dura 24 h; para produccion
# genera un token permanente de System User (B-37).
WHATSAPP_TOKEN=EAAG...
# phone_number_id (NO el WABA id ni el numero): va en la URL de envio.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token que VOS inventas y pegas en el panel al configurar el webhook; Meta lo
# devuelve en el GET de verificacion y tiene que coincidir.
WHATSAPP_VERIFY_TOKEN=un-token-secreto-que-vos-elegis
# App secret de la app de Meta -> valida la firma X-Hub-Signature-256 de cada
# POST. OBLIGATORIO en produccion: sin esto el bot RECHAZA todo el trafico
# entrante (antes lo aceptaba todo sin avisar, que era el problema — C-08).
WHATSAPP_APP_SECRET=
# Solo desarrollo local: permite correr sin app secret, aceptando POSTs sin
# firmar. En produccion esto NUNCA va en "si".
BOT_PERMITIR_SIN_FIRMA=no
# Version del Graph API (opcional; por defecto v21.0).
# GRAPH_API_VERSION=v21.0

# --- Fuente zoho_imap: bandeja de correo por IMAP ---
# La config de la fuente (en el registro) NO lleva la contraseña: lleva el
# NOMBRE de la variable, en 'password_env'. El secreto vive solo aca.
# Si tenes verificacion en dos pasos, generá una contraseña ESPECIFICA DE
# APLICACION en accounts.zoho.com -> Seguridad -> Contraseñas de aplicacion.
# Ojo: Zoho deshabilito IMAP en las cuentas gratuitas nuevas.
# "dias" en la config solo limita la relectura: la tabla conserva el historial
# y hace UPSERT. Dos Gmail pueden reenviar a la misma carpeta del buzon Zoho.
ZOHO_PASSWORD_FACHAVI=

# --- Fuente meta_ads: pauta de Facebook / Instagram ---
# La config de la fuente (en el registro) NO lleva el token: lleva el NOMBRE de
# la variable, en 'token_env'. Una variable POR CLIENTE, porque cada uno tiene
# su propia cuenta publicitaria y su propio acceso.
#
# Como sacar el token, en corto:
#   1. business.facebook.com -> Configuracion del negocio -> Usuarios ->
#      Usuarios del sistema -> Agregar (rol: Empleado basta para leer).
#   2. Asignarle ACTIVOS: la cuenta publicitaria del cliente, con permiso de
#      "Ver rendimiento". Sin este paso el token existe pero da error 200.
#   3. Generar token -> app del negocio -> permiso 'ads_read' (y 'read_insights'
#      si ademas vas a leer paginas). Sin caducidad.
#
# NO uses el token que da el Explorador de la API de Graph: caduca en 1-2 horas.
# Un token de usuario normal caduca a los 60 dias y la ingesta se cae sola un
# martes cualquiera, con error 190 en la bitacora.
# --- FORMA 1: un token para todos los clientes ---
# Es lo que corresponde cuando los clientes te dan acceso de SOCIO a TU
# Business Manager (Configuracion del negocio -> Socios -> Asignar activos).
# El mismo nombre se repite en el "token_env" de todas las filas del registro,
# y dar de alta un cliente NO requiere tocar Render.
META_ADS_TOKEN_FACHAVI=

# --- FORMA 2: un solo secreto con el token de cada cliente adentro ---
# Para clientes que emiten el token desde SU propio Business Manager. En el
# registro cada fila declara nada mas {"token_ref":"cliente_a"}; el secreto
# vive solo aca. Alta de cliente = una clave mas en este JSON.
# Tiene que ser un OBJETO JSON en UNA sola linea, con comillas RECTAS:
#   {"cliente_a":"EAAG...","cliente_b":"EAAH..."}
# Si una clave falta, el error de la ingesta lista las claves disponibles (no
# los tokens) para que un typo se vea de una.
META_ADS_TOKENS=
