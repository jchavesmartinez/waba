# Copiar a .env para correr local. NUNCA subir el .env real a GitHub.

# --- WhatsApp / Meta ---
VERIFY_TOKEN=fachavi-verify-2026
WHATSAPP_TOKEN=pega-tu-token-de-whatsapp
PHONE_NUMBER_ID=pega-el-id-del-numero
GRAPH_API_VERSION=v21.0

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Google Sheets ---
# Un solo service account lee el maestro Y los Sheets de datos de todos.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# ID del SHEET MAESTRO (registro de clientes/usuarios), NO el de datos.
MASTER_SPREADSHEET_ID=pega-el-id-del-sheet-maestro

# --- Ajustes opcionales ---
DATA_CACHE_TTL=60
REGISTRY_CACHE_TTL=300
MAX_RESULT_ROWS=100

# --- Warehouse (Fase 2/3: aterrizaje de la data cruda) ---
# Opcion A: DuckDB local (desarrollo)
WAREHOUSE_TIPO=duckdb
WAREHOUSE_DSN=fachavi.duckdb
# Opcion B: MotherDuck (produccion) — MISMO codigo, solo cambia el DSN
# WAREHOUSE_TIPO=duckdb
# WAREHOUSE_DSN=md:fachavi?motherduck_token=pega-tu-token
# Opcion C: Postgres administrado (Supabase / Neon)
# WAREHOUSE_TIPO=postgres
# WAREHOUSE_DSN=postgresql://usuario:clave@host:5432/basedatos
